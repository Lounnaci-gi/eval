# Copier vers epeor.env et ajuster si besoin (ou definir dans l'environnement Windows)
#
# Chemin du dossier contenant les fichiers de données EPEOR
EPEOR_DATA_DIR=d:\epeor
#
# Secret JWT pour les tokens d'accès Next.js (OBLIGATOIRE en production).
# - Longueur minimale : 32 caractères (64+ recommandés).
# - Génération : `openssl rand -hex 32` ou équivalent (Node `crypto.randomBytes(48).toString("hex")`).
# - NE JAMAIS utiliser la valeur par défaut "dev_access_secret_change_me" en prod.
# ACCESS_TOKEN_SECRET=changez_moi_avec_une_valeur_longue_et_aleatoire_d_au_moins_32_caracteres
#
# Origines autorisees pour CORS (frontend). Separateur : virgule.
# CORS_ORIGINS=http://localhost:3000,http://192.168.100.8:3000
#
# Regex optionnel (tunnel Cloudflare, sous-domaines) :
# CORS_ORIGIN_REGEX=https://.*\.trycloudflare\.com
